# انسخ الملف ده باسم .env وعدّل القيم. الأسطر اللي بتبدأ بـ # مجرد شرح.

# --- الأساسي ---
PORT=3000
# 127.0.0.1 = للجهاز ده بس (أأمن). 0.0.0.0 = متاح من الشبكة (Docker بيظبطها لوحده)
HOST=127.0.0.1
# مكان قاعدة البيانات والنسخ الاحتياطية
DATA_DIR=./data
# عنوان الموقع الحقيقي (مهم لروابط الإيميلات). مثال: https://app.example.com
BASE_URL=
# لو BASE_URL فاضي: الدومينات اللي مسموح تتبني منها روابط الإيميل (مفصولة بفواصل). مثال: 192.168.1.20:3000
ALLOWED_HOSTS=
# فعّلها (1) لو السيرفر ورا Caddy / Nginx عشان يقرا عنوان المستخدم الحقيقي
TRUST_PROXY=0

# --- الدومين (لـ docker compose + Caddy فقط) ---
DOMAIN=app.example.com

# --- الإدارة ---
# إيميل مدير الخدمة (لو فاضي: أول حساب يتسجل هو المدير)
ADMIN_EMAIL=
# السماح بتسجيل شركات جديدة (0 = مقفول، الدخول بدعوة فقط)
ALLOW_REGISTRATION=1
# إجبار تفعيل الإيميل قبل أول دخول (محتاج SMTP شغال)
REQUIRE_VERIFY=0

# --- الإيميل SMTP (اختياري) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SIYADA <no-reply@example.com>

# --- النسخ الاحتياطي ---
BACKUP_HOUR=3
BACKUP_KEEP=14
SESSION_DAYS=30
