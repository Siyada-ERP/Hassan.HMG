# --- build output (generated by `npm run build`) ---
/dist/
/server/public/

# --- dependencies ---
node_modules/

# --- runtime data: never commit databases, backups or secrets ---
/server/data/
data/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# --- real company data: only anonymised fixtures may live in the repo ---
/private/
/exports/
*.xlsm
*.xlsx
*.xlsb
~$*
*.tmp

# --- test artifacts ---
/tests/e2e/shots/
__pycache__/
*.pyc
.pytest_cache/

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
